{
  "botName": "opencode",
  "trigger": "!oc",
  "rateLimitSeconds": 5,
  "toolMessages": {
    "mode": "events",
    "showArguments": false,
    "showOutputFor": ["bash"],
    "maxTraceEntries": 20,
    "summaries": {
      "allowedTools": [],
      "allowedFields": [],
      "maxFieldLength": 120,
      "unlistedTools": "name"
    }
  },
  "safeOutput": {
    "redactSecrets": true,
    "allowRawToolOutput": false
  },
  "permissions": {
    "interactive": true,
    "timeoutSeconds": 180
  },
  "sessionStorePath": "./.opencode/chat-sessions.json",
  "defaultAgent": null,
  "verboseErrors": false,
  "sessionPicker": {
    "enabled": false,
    "connectors": [],
    "mirrorIntervalSeconds": 60
  },
  "acp": {
    "command": "opencode",
    "args": ["acp"],
    "backendId": "opencode",
    "profileDir": "",
    "sessionCwd": ""
  },
  "matrix": {
    "enabled": false,
    "homeserver": "https://matrix.org",
    "userId": "{env:MATRIX_USER_ID}",
    "accessToken": "{env:MATRIX_ACCESS_TOKEN}",
    "password": "{env:MATRIX_PASSWORD}",
    "deviceId": "OPENCODE_BRIDGE",
    "encryption": {
      "enabled": false,
      "storePath": "./matrix-store/"
    },
    "autoJoin": true,
    "triggerPatterns": ["!oc "],
    "ignoreRooms": [],
    "ignoreUsers": [],
    "allowedUsers": [],
    "allowedRooms": [],
    "formatHtml": false,
    "threadIsolation": true,
    "respondToThreadReplies": true,
    "logInboundMessages": false
  },
  "mattermost": {
    "enabled": false,
    "url": "{env:MATTERMOST_URL}",
    "token": "{env:MATTERMOST_TOKEN}",
    "teamName": "",
    "respondToMentions": true,
    "respondToThreadReplies": true,
    "ignoreChannels": [],
    "ignoreUsers": [],
    "allowedUsers": [],
    "threadIsolation": true
  },
  "whatsapp": {
    "enabled": false,
    "authFolder": "./.whatsapp-auth",
    "allowedUsers": [],
    "allowedGroups": [],
    "respondToOthers": true,
    "autoUploadFiles": false,
    "logInboundMessages": false
  },
  "slack": {
    "enabled": false,
    "allowedUsers": [],
    "allowedChannels": [],
    "threadIsolation": true,
    "respondToThreadReplies": true,
    "autoUploadFiles": false,
    "logInboundMessages": false
  },
  "discord": {
    "enabled": false,
    "allowedUsers": []
  },
  "telegram": {
    "enabled": false,
    "token": "{env:TELEGRAM_BOT_TOKEN}",
    "respondToMentions": true,
    "threadIsolation": true,
    "respondToImplicitTopicReplies": true,
    "respondToReplies": true,
    "attachments": {
      "enabled": true,
      "maxFileBytes": 20971520,
      "maxFilesPerMessage": 4
    },
    "ignoreChats": [],
    "ignoreUsers": [],
    "allowedUsers": []
  },
  "web": {
    "enabled": false,
    "port": 3420,
    "host": "0.0.0.0",
    "allowedOrigins": ["*"],
    "publicUrl": ""
  }
}
